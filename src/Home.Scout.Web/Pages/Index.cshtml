@page
@model IndexModel
@{
    ViewData["Title"] = "Home Scout - RSS News Aggregator";
}

<div class="container py-5 text-center">
    <h1 class="display-4 mb-4">🏠 Home Scout</h1>
    <p class="lead mb-4">Agregator newsów z kanałów RSS</p>
    
    <div class="row mt-5">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">📰 Wszystkie newsy</h5>
                    <p class="card-text">Przeglądaj wszystkie pobrane artykuły z kanałów RSS.</p>
                    <a href="/News" class="btn btn-primary">Przejdź do newsów</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">📡 Kanały RSS</h5>
                    <p class="card-text">Dodaj, edytuj lub usuń kanały RSS oraz pobierz artykuły.</p>
                    <a href="/Channels" class="btn btn-info">Zarządzaj kanałami</a>
                </div>
            </div>
        </div>
    </div>
</div>
