@{
    Layout = "_Layout";
    var currentCategory = SettingsCategories.FindForPage(ViewContext.RouteData.Values["page"] as string);
}

<div class="py-4">
    <h2 class="h5 text-muted text-uppercase mb-3">Settings</h2>
    <div class="row">
        <div class="col-md-3 mb-3">
            <nav aria-label="Settings categories">
                <ul class="nav nav-pills flex-row flex-md-column gap-1">
                    @foreach (var category in SettingsCategories.All)
                    {
                        var isActive = category == currentCategory;
                        <li class="nav-item">
                            <a class="nav-link @(isActive ? "active" : "text-dark")"
                               aria-current="@(isActive ? "page" : null)"
                               asp-page="@category.EntryPage">
                                <i class="bi @category.Icon" aria-hidden="true"></i> @category.Title
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
