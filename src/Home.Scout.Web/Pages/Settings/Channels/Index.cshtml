@page "/settings/channels"
@model Home.Scout.Web.Pages.Settings.Channels.IndexModel
@{
    ViewData["Title"] = "RSS Channels";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="col-md-4 text-end">
        <a href="/settings/channels/create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add channel
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model?.StatusMessage))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model?.Channels?.Any() == true)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>URL</th>
                    <th>Description</th>
                    <th>Added at</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var channel in Model.Channels)
                {
                    <tr>
                        <td><strong>@channel.Name</strong></td>
                        <td>
                            <a href="@channel.Url" target="_blank" class="text-truncate d-inline-block" style="max-width: 250px;">
                                @channel.Url
                            </a>
                        </td>
                        <td class="text-muted">@(string.IsNullOrEmpty(channel.Description) ? "-" : channel.Description)</td>
                        <td>@channel.CreatedAt.ToString("g")</td>
                        <td>
                            <form method="post" asp-page-handler="FetchNow" asp-route-id="@channel.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="bi bi-arrow-repeat"></i> Fetch now
                                </button>
                            </form>
                            <a href="/settings/channels/edit/@channel.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a href="/settings/channels/delete/@channel.Id" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle"></i> RSS Channels are empty <a href="/settings/channels/create">Add first one!</a>.
    </div>
}



