@page "/settings/channels"
@model Home.Scout.Web.Pages.Settings.Channels.IndexModel
@{
    ViewData["Title"] = "RSS Channels";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="col-md-4 text-end">
        <a href="/settings/channels/create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add channel
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model?.StatusMessage))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model?.Channels?.Any() == true)
{
    <div class="channels-table">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th class="channels-col-name">Name</th>
                    <th>URL</th>
                    <th class="d-none d-md-table-cell">Description</th>
                    <th class="d-none d-md-table-cell">Added at</th>
                    <th class="channels-col-actions">
                        <span class="d-none d-md-inline">Actions</span>
                        <span class="visually-hidden d-md-none">Actions</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var channel in Model.Channels)
                {
                    <tr>
                        <td class="text-truncate" title="@channel.Name"><strong>@channel.Name</strong></td>
                        <td>
                            <a href="@channel.Url" target="_blank" class="channel-url d-block text-truncate" title="@channel.Url">
                                @channel.Url
                            </a>
                        </td>
                        <td class="text-muted d-none d-md-table-cell">@(string.IsNullOrEmpty(channel.Description) ? "-" : channel.Description)</td>
                        <td class="d-none d-md-table-cell">@channel.CreatedAt.ToString("g")</td>
                        <td>
                            <div class="d-none d-md-inline-flex flex-wrap gap-1">
                                <form method="post" asp-page-handler="FetchNow" asp-route-id="@channel.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-arrow-repeat"></i> Fetch now
                                    </button>
                                </form>
                                <a href="/settings/channels/edit/@channel.Id" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a href="/settings/channels/delete/@channel.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                            <div class="dropdown d-md-none">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown"
                                        aria-expanded="false" aria-label="Actions for @channel.Name">
                                    <i class="bi bi-three-dots" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <form method="post" asp-page-handler="FetchNow" asp-route-id="@channel.Id">
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Fetch now
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/settings/channels/edit/@channel.Id">
                                            <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="/settings/channels/delete/@channel.Id">
                                            <i class="bi bi-trash" aria-hidden="true"></i> Delete
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle"></i> RSS Channels are empty <a href="/settings/channels/create">Add first one!</a>.
    </div>
}



