@page
@model Home.Scout.Web.Pages.News.IndexModel
@{
    ViewData["Title"] = "All News";
}

<div class="container-fluid py-4">
    @if (Model?.NewsItems?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 120px;">Date</th>
                        <th>News</th>
                        <th style="width: 100px;">Source</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var news in Model.NewsItems)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <small>@news.PublishedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            </td>
                            <td>
                                <strong>
                                    @if (!string.IsNullOrEmpty(news.Link))
                                    {
                                        <a href="@news.Link" target="_blank">@news.Title</a>
                                    }
                                    else
                                    {
                                        @news.Title
                                    }
                                </strong>
                                <br />
                                <small class="text-muted">
                                    @(string.IsNullOrEmpty(news.Description) ? "-" : news.Description)
                                </small>
                            </td>
                            <td>
                                @if (Model.ChannelNames.TryGetValue(news.RssChannelId, out var channelName))
                                {
                                    <span class="badge bg-info">@channelName</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> No news available. <a href="/Channels">Add RSS channels and fetch articles</a>.
        </div>
    }
</div>
