@page
@model Home.Scout.Web.Pages.News.IndexModel
@{
    ViewData["Title"] = "Wszystkie newsy";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Channels" class="btn btn-info">
                <i class="bi bi-rss"></i> Zarządzaj kanałami
            </a>
        </div>
    </div>

    @if (Model?.NewsItems?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 120px;">Data i godzina</th>
                        <th>Tytuł</th>
                        <th style="width: 250px;">Opis</th>
                        <th style="width: 100px;">Źródło</th>
                        <th style="width: 80px;">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var news in Model.NewsItems)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <small>@news.PublishedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            </td>
                            <td>
                                <strong>
                                    @if (!string.IsNullOrEmpty(news.Link))
                                    {
                                        <a href="@news.Link" target="_blank">@news.Title</a>
                                    }
                                    else
                                    {
                                        @news.Title
                                    }
                                </strong>
                            </td>
                            <td class="text-muted">
                                <small>@(string.IsNullOrEmpty(news.Description) ? "-" : news.Description)</small>
                            </td>
                            <td>
                                @if (Model.ChannelNames.TryGetValue(news.RssChannelId, out var channelName))
                                {
                                    <span class="badge bg-info">@channelName</span>
                                }
                            </td>
                            <td>
                                <a href="/News/Delete/@news.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> Brak newsów. <a href="/Channels">Dodaj kanały RSS i pobierz artykuły</a>.
        </div>
    }
</div>


