@page "{id:int}"
@model Home.Scout.Web.Pages.News.DeleteModel
@{
    ViewData["Title"] = "Usuń news";
}

<div class="container py-4">
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Czy na pewno?</h4>
        <p>Czy na pewno chcesz usunąć ten artykuł?</p>
    </div>

    @if (Model?.NewsItem != null)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@Model.NewsItem.Title</h5>
                <p class="card-text">@Model.NewsItem.Description</p>
                <small class="text-muted">Opublikowano: @Model.NewsItem.PublishedAt.ToString("g")</small>
            </div>
        </div>

        <form method="post" style="display: inline;">
            <button type="submit" class="btn btn-danger">Usuń</button>
        </form>
        <a href="/News" class="btn btn-secondary">Anuluj</a>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Artykuł nie został znaleziony.
        </div>
        <a href="/News" class="btn btn-secondary">Powrót do newsów</a>
    }
</div>

