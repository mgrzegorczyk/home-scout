@page
@model Home.Scout.Web.Pages.Channels.IndexModel
@{
    ViewData["Title"] = "Kanały RSS";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Channels/Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Dodaj kanał
            </a>
        </div>
    </div>

    @if (Model?.Channels?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Nazwa</th>
                        <th>URL</th>
                        <th>Opis</th>
                        <th>Data dodania</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var channel in Model.Channels)
                    {
                        <tr>
                            <td><strong>@channel.Name</strong></td>
                            <td>
                                <a href="@channel.Url" target="_blank" class="text-truncate d-inline-block" style="max-width: 250px;">
                                    @channel.Url
                                </a>
                            </td>
                            <td class="text-muted">@(string.IsNullOrEmpty(channel.Description) ? "-" : channel.Description)</td>
                            <td>@channel.CreatedAt.ToString("g")</td>
                            <td>
                                <a href="/Channels/Edit/@channel.Id" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Edytuj
                                </a>
                                <a href="/Channels/Delete/@channel.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Usuń
                                </a>
                                <a href="/Channels/Fetch/@channel.Id" class="btn btn-sm btn-success">
                                    <i class="bi bi-download"></i> Pobierz
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> Nie masz jeszcze żadnych kanałów RSS. <a href="/Channels/Create">Dodaj pierwszy kanał</a>.
        </div>
    }
</div>



