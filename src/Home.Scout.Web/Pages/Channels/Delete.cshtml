@page "{id:int}"
@model Home.Scout.Web.Pages.Channels.DeleteModel
@{
    ViewData["Title"] = "Usuń kanał RSS";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Czy na pewno?</h4>
                <p>Czy na pewno chcesz usunąć ten kanał RSS?</p>
                <hr>
                <p class="mb-0">Wszystkie artykuły z tego kanału również zostaną usunięte.</p>
            </div>

            @if (Model?.Channel != null)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@Model.Channel.Name</h5>
                        <p class="card-text">@Model.Channel.Description</p>
                        <a href="@Model.Channel.Url" target="_blank" class="btn btn-sm btn-link">Odwiedź kanał</a>
                    </div>
                </div>

                <form method="post" style="display: inline;">
                    <button type="submit" class="btn btn-danger">Usuń kanał i artykuły</button>
                </form>
                <a href="/Channels" class="btn btn-secondary">Anuluj</a>
            }
            else
            {
                <div class="alert alert-warning" role="alert">
                    Kanał nie został znaleziony.
                </div>
                <a href="/Channels" class="btn btn-secondary">Powrót do kanałów</a>
            }
        </div>
    </div>
</div>

