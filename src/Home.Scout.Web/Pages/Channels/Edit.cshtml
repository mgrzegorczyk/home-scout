@page "{id:int}"
@model Home.Scout.Web.Pages.Channels.EditModel
@{
    ViewData["Title"] = "Edytuj kanał RSS";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>@ViewData["Title"]</h1>

            @if (Model?.Channel == null)
            {
                <div class="alert alert-danger" role="alert">
                    Kanał nie został znaleziony.
                </div>
            }
            else
            {
                <form method="post" class="needs-validation mt-4">
                    <input type="hidden" asp-for="Channel.Id" />

                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label">Nazwa kanału *</label>
                        <input asp-for="Input.Name" class="form-control" required />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Url" class="form-label">URL kanału RSS *</label>
                        <input asp-for="Input.Url" type="url" class="form-control" required />
                        <span asp-validation-for="Input.Url" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label">Opis (opcjonalnie)</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                        <a href="/Channels" class="btn btn-secondary">Anuluj</a>
                        <button type="submit" class="btn btn-primary">Zaktualizuj kanał</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


