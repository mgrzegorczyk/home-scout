@page "{id:int}"
@model Home.Scout.Web.Pages.Channels.FetchModel
@{
    ViewData["Title"] = "Pobierz artykuły";
}

<div class="container py-4">
    @if (Model?.Channel == null)
    {
        <div class="alert alert-danger" role="alert">
            Kanał nie został znaleziony.
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col">
                <h1>Pobieranie artykułów z kanału: <strong>@Model.Channel.Name</strong></h1>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert @(Model.FetchedItems.Count > 0 ? "alert-success" : "alert-info")" role="alert">
                @Model.Message
            </div>
        }

        @if (Model.FetchedItems.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Tytuł</th>
                            <th>Opis</th>
                            <th>Data publikacji</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.FetchedItems)
                        {
                            <tr>
                                <td><strong>@item.Title</strong></td>
                                <td class="text-muted">@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                                <td>@item.PublishedAt.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="mt-4">
            <a href="/Channels" class="btn btn-secondary">Powrót do kanałów</a>
            <a href="/News" class="btn btn-primary">Przejdź do wszystkich newsów</a>
        </div>
    }
</div>

